[Unit]
Description=Toss Orbit bounded research worker
After=network-online.target toss.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Toss
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/python3 /home/ubuntu/Toss/research_supervisor.py
Nice=10
CPUQuota=45%
MemoryHigh=384M
MemoryMax=650M
OOMPolicy=continue
TimeoutStartSec=540
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
